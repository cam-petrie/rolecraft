# Copy to .dev.vars for npm run gateway. Never commit .dev.vars.
# Use a dedicated GitHub OAuth App with callback http://127.0.0.1:8787/auth/callback.
GITHUB_CLIENT_ID=replace-with-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-client-secret
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
OWNER_GITHUB_ID=90569344
# Optional: only OWNER_GITHUB_ID can access this server-side OpenAI key.
OPENAI_API_KEY=replace-with-owner-api-key
OPENAI_MODEL=gpt-6-luna
ALLOWED_ORIGINS=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173/
